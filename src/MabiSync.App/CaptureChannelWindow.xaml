<Window x:Class="MabiSync.App.CaptureChannelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="抓包通道校对" Width="750" Height="550" MinWidth="580" MinHeight="430" WindowStartupLocation="CenterOwner" Background="#F1F4F9" FontSize="14">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
    <TextBlock Text="抓包通道校对" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Text="选择游戏与网络通道，启用昵称和合奏加入顺序识别。" TextWrapping="Wrap" Margin="0,8,0,12" />
    <TextBlock Text="游戏窗口" /><ComboBox x:Name="GamesBox" DisplayMemberPath="Label" SelectionChanged="GameChanged" />
    <TextBlock Text="网卡 / 加速器通道" /><ComboBox x:Name="DevicesBox" DisplayMemberPath="Label" SelectionChanged="DeviceChanged" />
    <TextBlock Text="该游戏的 IPv4 TCP 连接" /><ComboBox x:Name="ConnectionsBox" DisplayMemberPath="Label" />
    <WrapPanel><Button x:Name="ObserveButton" Content="开始" Click="ObserveClick" Style="{StaticResource PrimaryAction}" /><Button x:Name="StopObserveButton" Content="停止识别" Click="StopObserveClick" IsEnabled="False" /></WrapPanel>
    <Expander Header="检查通道流量"><WrapPanel><Button x:Name="RefreshButton" Content="刷新通道" Click="RefreshClick" /><Button x:Name="CheckButton" Content="检查 30 秒" Click="CheckClick" /><Button x:Name="CancelButton" Content="停止检查" Click="StopClick" IsEnabled="False" /></WrapPanel></Expander>
    <Border Background="White" Padding="14" CornerRadius="8" Margin="0,8,0,0"><StackPanel>
      <TextBlock x:Name="CaptureStateText" Text="尚未开始校对。" TextWrapping="Wrap" />
      <TextBlock x:Name="CountText" Text="收到的数据包：0" Margin="0,8,0,0" />
      <TextBlock x:Name="IdentityText" Text="角色识别：尚未确认。启用后请切换地图或重新登录角色。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#67758C" />
      <TextBlock x:Name="ScoreText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#67758C" Visibility="Collapsed" />
      <TextBlock Text="识别在后台持续运行。可关闭此窗口返回房间；退出 MabiSync 时结束。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#67758C" />
    </StackPanel></Border>
    <TextBlock TextWrapping="Wrap" Foreground="#67758C" Margin="0,12,0,0">昵称、乐谱和加入顺序识别需要另行安装 Npcap，发布包未附带驱动。<LineBreak /><Hyperlink NavigateUri="https://npcap.com/#download" RequestNavigate="NpcapDownloadClick">Npcap 官方下载：https://npcap.com/#download</Hyperlink><LineBreak />安装完成后重新打开抓包校对。切换网络或加速器后，可停止识别并重新选择通道。</TextBlock>
  </StackPanel></ScrollViewer>
</Window>
