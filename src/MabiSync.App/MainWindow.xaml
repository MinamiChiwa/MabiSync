<Window x:Class="MabiSync.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MabiSync.App" Title="MabiSync" Icon="Assets/MabiSync.ico" Width="1180" Height="900" MinWidth="760" MinHeight="640" Background="#10151E" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <Border x:Name="InputBadgeCard" Background="#173D32" CornerRadius="6" Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock x:Name="InputBadge" Text="游戏输入已开启" Foreground="#86E1B2" /></Border>
        <Button x:Name="SponsorButton" Style="{StaticResource HeaderIcon}" Click="SponsorClick" ToolTip="支持 MabiSync：爱发电 / Patreon" AutomationProperties.Name="赞助入口"><Viewbox Width="19" Height="19"><Path Fill="#EAB6CA" Data="M12 21 C8 18 2 14 2 8 A5 5 0 0 1 12 6 A5 5 0 0 1 22 8 C22 14 16 18 12 21 Z" /></Viewbox></Button>
        <Button x:Name="PinWindowButton" Style="{StaticResource HeaderIcon}" Click="PinWindowClick"><Viewbox Width="20" Height="20"><Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8 3 L16 3 M9 3 L9 8 L5 13 L19 13 L15 8 L15 3 M12 13 L12 22" /></Viewbox></Button>
        <Button x:Name="CapturePrivacyButton" Style="{StaticResource HeaderIcon}" Click="CapturePrivacyClick"><Viewbox Width="20" Height="20"><Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3 3 L21 21 M5 5 C3 7 2 10 1 12 C4 18 9 21 15 19 M9 4 C15 2 20 7 23 12 C22 14 21 15 20 16 M9 9 A4 4 0 0 0 15 15" /></Viewbox></Button>
      </StackPanel>
      <StackPanel><TextBlock Text="MabiSync" FontSize="22" FontWeight="SemiBold" /><Border x:Name="RoleSummaryCard" Background="#243B55" BorderBrush="#456386" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,6,12,0" HorizontalAlignment="Left"><TextBlock x:Name="RoleSummaryText" Text="创建房间，或接受好友邀请" Foreground="#C6DEFF" FontWeight="SemiBold" TextWrapping="Wrap" /></Border></StackPanel>
    </DockPanel>
    <Border x:Name="StatusCard" DockPanel.Dock="Bottom" Background="#182C43" BorderBrush="#527EAB" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,10,0,0">
      <DockPanel LastChildFill="True">
        <Border x:Name="FeedbackBanner" DockPanel.Dock="Top" Background="#203552" CornerRadius="6" Padding="10,7" Margin="0,0,0,10" Visibility="Collapsed"><DockPanel><TextBlock Visibility="Collapsed" x:Name="FeedbackKindText" Text="操作反馈" FontWeight="SemiBold" Foreground="#9DC7FF" Margin="0,0,10,0" /><TextBlock x:Name="MessageText" Text="" TextWrapping="Wrap" Foreground="#9DC7FF" /></DockPanel></Border>
        <WrapPanel x:Name="StatusActions" DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <WrapPanel x:Name="CountdownControls"><TextBlock Text="倒计时" VerticalAlignment="Center" /><TextBox x:Name="CountdownBox" Text="5" Width="70" MaxLength="8" TextChanged="CountdownChanged" ToolTip="1–60 秒，支持小数" /><TextBlock Text="秒" VerticalAlignment="Center" Margin="0,0,14,0" /></WrapPanel>
          <Button x:Name="ReadyButton" MinWidth="140" Content="就绪" Click="ReadyClick" /><Button x:Name="StartButton" Content="开始" Click="PrepareClick" Style="{StaticResource PrimaryAction}" />
          <Button x:Name="CancelButton" Content="取消本轮" Click="CancelClick" /><Button x:Name="LocalStopButton" Content="取消本机任务" Click="LocalStopClick" />
          <Button x:Name="StopButton" Content="全员停止" Click="StopClick" Style="{StaticResource StopAction}" /><Button x:Name="ReportLeaderButton" Content="总指挥提前结束" Click="ReportLeaderClick" /><Button x:Name="ContinueButton" Content="继续演奏" Click="ContinueClick" />
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <Expander x:Name="StatusSection" IsExpanded="True"><Expander.Header><StackPanel>
            <TextBlock x:Name="PhaseText" Text="连接房间" FontSize="22" Foreground="#9DC7FF" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="NextStepText" Text="创建房间，或粘贴邀请加入。" TextWrapping="Wrap" FontSize="12" Foreground="#BECBDD" Margin="0,4,0,0" />
            <TextBlock x:Name="StatusTimingSummary" Text="本机微调：0 ms · 不调整" Foreground="#9DC7FF" FontSize="12" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded,ElementName=StatusSection}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </StackPanel></Expander.Header><StackPanel>
        <Border x:Name="NetworkBanner" Background="#203552" CornerRadius="6" Padding="10,7" Margin="0,8,0,0" Visibility="Collapsed"><TextBlock x:Name="NetworkBannerText" Foreground="#9DC7FF" FontWeight="SemiBold" TextWrapping="Wrap" /></Border>
        <StackPanel x:Name="CountdownPanel" Visibility="Collapsed" Margin="0,10,0,3"><DockPanel><TextBlock x:Name="CountdownLabel" Text="距离开始" /><TextBlock x:Name="CountdownValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#9DC7FF" /></DockPanel><ProgressBar x:Name="CountdownProgress" Height="9" Margin="0,6,0,0" Minimum="0" Maximum="1" Value="0" Foreground="#79ACFF" Background="#2B3A50" BorderThickness="0" /></StackPanel>
        <Border x:Name="ScoreCard" Background="#202C3D" CornerRadius="6" Padding="10,7" Margin="0,8,0,0" Visibility="Collapsed"><TextBlock x:Name="ScoreObservationText" Foreground="#BECBDD" TextWrapping="Wrap" /></Border>
        <TextBlock x:Name="MusicStatusText" TextWrapping="Wrap" Foreground="#A8B4C7" Margin="0,4,0,0" Visibility="Collapsed" />
        <WrapPanel x:Name="StopControls" Margin="0,6,0,0"><TextBlock Text="停止方式" VerticalAlignment="Center" Margin="0,0,10,0" /><ComboBox x:Name="StopChoice" Width="240" SelectedIndex="2" SelectionChanged="ModeChanged"><ComboBoxItem Content="房主手动统一停止" Tag="manual" /><ComboBoxItem Content="手动指定演奏时长" Tag="duration" /><ComboBoxItem Content="总指挥一轮后全员停止" Tag="first-cycle" /></ComboBox><Button Style="{StaticResource HelpIcon}" ToolTip="{Binding Text,ElementName=LeaderPurposeText}" /><WrapPanel x:Name="DurationControls"><TextBox x:Name="DurationBox" Width="90" Text="30" TextChanged="MusicDurationChanged" ToolTip="从本轮计划开始输入到计划停止输入之间的秒数" /><TextBlock Text="秒" VerticalAlignment="Center" /></WrapPanel></WrapPanel>
            <TextBlock x:Name="CountdownHint" Visibility="Collapsed" />
        <Expander x:Name="TimingAdjustmentSection" Header="本机时间微调 · 0 ms · 不调整" IsExpanded="True" Margin="0,6,0,0"><StackPanel><WrapPanel><Slider x:Name="TimingOffsetSlider" Width="220" Minimum="-2000" Maximum="2000" Value="0" TickFrequency="1" TickPlacement="BottomRight" Ticks="-2000,-1800,-1600,-1400,-1200,-1000,-800,-600,-400,-200,0,200,400,600,800,1000,1200,1400,1600,1800,2000" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="False" ValueChanged="TimingOffsetChanged" VerticalAlignment="Center" ToolTip="范围 −2000～+2000 毫秒，步进 1 毫秒" /><TextBox x:Name="TimingOffsetBox" Text="0" Width="80" MaxLength="6" TextChanged="TimingOffsetTextChanged" LostKeyboardFocus="TimingOffsetBlurred" PreviewKeyDown="TimingOffsetKeyDown" ToolTip="整数毫秒；负数提前，正数延后" /><TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock x:Name="TimingOffsetValue" Text="0 ms · 不调整" Visibility="Collapsed" /><TextBlock Text="负数提前，正数延后" Foreground="#A8B4C7" VerticalAlignment="Center" Margin="0,0,8,0" /><Button x:Name="ResetTimingButton" Content="归零" Click="ResetTimingClick" /><Button Style="{StaticResource HelpIcon}" ToolTip="按本机与队友的体验调整，负数提前，正数延后。修改后重新就绪，本轮使用安排时的数值。" /></WrapPanel></StackPanel></Expander>
          </StackPanel></Expander>
        </StackPanel></ScrollViewer>
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="WorkflowScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Style="{StaticResource Card}"><Expander x:Name="RoomSection" IsExpanded="True"><Expander.Header><DockPanel><TextBlock Text="1  连接房间" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="ConnectionStatus" Text="尚未连接" Margin="16,0,0,0" Foreground="#A8B4C7" /></DockPanel></Expander.Header><StackPanel x:Name="RoomControls">
          <WrapPanel><TextBlock Text="昵称" VerticalAlignment="Center" Margin="0,0,8,0" /><Grid><TextBox x:Name="NicknameBox" Width="140" MaxLength="20" TextChanged="NicknameChanged" ToolTip="填写游戏昵称，或通过抓包识别更新" /><TextBlock Text="填写游戏昵称" Foreground="#91A0B5" Margin="17,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=NicknameBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button x:Name="RefreshObservationButton" Content="更新昵称" Click="RefreshObservationClick" /><Button x:Name="CaptureChannelsButton" Content="抓包校对" Click="CaptureChannelsClick" /><Button x:Name="CopyPublicButton" Content="复制邀请" Click="CopyPublicClick" IsEnabled="False" /><Button x:Name="ReconnectRoomButton" Content="重新连接" Click="ReconnectRoomClick" Visibility="Collapsed" /><Button x:Name="LeaveRoomButton" Content="离开房间" Click="LeaveClick" /></WrapPanel>
          <TextBlock x:Name="ObservationStatusText" Text="抓包识别可更新本机昵称，并核对合奏加入顺序。" TextWrapping="Wrap" Foreground="#A8B4C7" Margin="0,4,0,6" />
          <TextBlock x:Name="CopyStatusText" Foreground="#86E1B2" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,3,0,6" />
          <StackPanel x:Name="FallbackInvitationPanel" Visibility="Collapsed"><TextBox x:Name="FallbackInvitationBox" IsReadOnly="True" TextWrapping="Wrap" ToolTip="选中邀请并按 Ctrl+C，再发给好友" /></StackPanel>
          <WrapPanel x:Name="PublicProviderControls"><TextBlock Text="联机方式" VerticalAlignment="Center" Margin="0,0,8,0" /><ComboBox x:Name="PublicProviderBox" Width="230" SelectedIndex="2" SelectionChanged="PublicProviderChanged"><ComboBoxItem Content="Cloudflare 公网" Tag="cloudflare" /><ComboBoxItem Content="局域网" Tag="lan" /><ComboBoxItem Content="服务器直连（非长期）" Tag="community" /></ComboBox><Button x:Name="QuickCreateButton" Content="创建公网房间" Click="QuickCreateClick" /><Button x:Name="CancelNetworkButton" Content="取消连接" Visibility="Collapsed" Click="CancelNetworkClick" /></WrapPanel>
          <TextBlock x:Name="PublicProviderHint" TextWrapping="Wrap" Foreground="#A8B4C7" Margin="0,3,0,6" Text="Cloudflare：创建临时公网地址，好友粘贴邀请即可加入。" />
          <WrapPanel x:Name="LanControls" Visibility="Collapsed"><TextBlock Text="房主地址" VerticalAlignment="Center" Margin="0,0,8,0" /><ComboBox x:Name="LanAddressBox" IsEditable="True" Width="250" ToolTip="房主选择本机网卡地址；成员填写房主分享的地址。" /><Button x:Name="LanTutorialButton" Content="连接教程" Click="LanTutorialClick" /></WrapPanel>
          <StackPanel x:Name="InvitationControls"><DockPanel><Button DockPanel.Dock="Right" x:Name="JoinInvitationButton" Content="加入邀请" Click="JoinInvitationClick" /><TextBox x:Name="InvitationBox" ToolTip="粘贴房主复制的完整邀请" /></DockPanel>
          <TextBlock Visibility="Collapsed" x:Name="InvitationHint" Text="加入方：将完整邀请粘贴到上框，点击“加入邀请”。" Foreground="#A8B4C7" TextWrapping="Wrap" /></StackPanel>
          <TextBlock x:Name="RoomTitle" Text="尚未加入房间" Margin="0,8,0,4" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="PublicStateText" Text="异地玩家：房主创建公网房间后分享完整邀请。" TextWrapping="Wrap" Foreground="#A8B4C7" />
          <Expander x:Name="AdvancedConnection" Header="高级连接 · 局域网 / 手动地址 / 公网管理" Margin="0,12,0,0"><StackPanel x:Name="AdvancedConnectionControls" Margin="0,8,0,0">
            <TextBlock Text="服务地址" /><DockPanel><Button DockPanel.Dock="Right" x:Name="ConnectButton" Content="连接 / 重连" Click="ConnectClick" /><TextBox x:Name="EndpointBox" Text="ws://127.0.0.1:3132" /></DockPanel>
            <WrapPanel><Button Content="启动本机服务" Click="StartServerClick" /><CheckBox x:Name="LanCheck" Content="允许同局域网加入" VerticalAlignment="Center" Margin="4,0,12,0" /><Button Content="创建房间" Click="CreateClick" /><TextBox x:Name="CodeBox" Width="100" MaxLength="6" ToolTip="六位房间码" /><Button Content="加入房间" Click="JoinClick" /></WrapPanel>
            <WrapPanel><Button x:Name="OpenPublicButton" Content="建立公网连接" Click="OpenPublicClick" /><Button Content="关闭公网连接" Click="ClosePublicClick" /></WrapPanel>
            <TextBox x:Name="PublicAddressBox" IsReadOnly="True" ToolTip="临时公网地址；推荐使用“复制完整邀请”" />
          </StackPanel></Expander>
        </StackPanel></Expander></Border>
        <Border Style="{StaticResource Card}"><Expander x:Name="ModeSection" IsExpanded="True"><Expander.Header><DockPanel><TextBlock Text="2  本轮模式" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="ModeSummaryText" Text="表情动作" Margin="16,0,0,0" Foreground="#A8B4C7" /></DockPanel></Expander.Header><StackPanel>
          <ComboBox x:Name="ModeBox" Width="175" HorizontalAlignment="Left" SelectedIndex="1" SelectionChanged="ModeChanged"><ComboBoxItem Content="表情动作" Tag="emote" /><ComboBoxItem Content="合奏" Tag="ensemble" /></ComboBox>
          <TextBlock x:Name="FlowHint" Foreground="#A8B4C7" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel></Expander></Border>
        <Border x:Name="LocalActionCard" Style="{StaticResource Card}"><Expander x:Name="LocalActionSection" IsExpanded="True"><Expander.Header><WrapPanel VerticalAlignment="Center"><TextBlock x:Name="LocalActionTitle" Text="3  本机动作" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="LocalActionSummary" Text="选择窗口并设置绑定" Margin="16,0,0,0" MaxWidth="370" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#A8B4C7" /></WrapPanel></Expander.Header><StackPanel>
          <TextBlock x:Name="EnsembleRoleText" TextWrapping="Wrap" Margin="0,0,0,8" />
          <StackPanel x:Name="InputControls">
            <WrapPanel><CheckBox x:Name="EnableGameInput" Content="操作游戏" IsChecked="True" Checked="InputSettingsChanged" Unchecked="InputSettingsChanged" Margin="0,5,18,5" ToolTip="勾选后按本机绑定执行；关闭时运行模拟" /><CheckBox x:Name="ShowOtherWindows" Content="显示其他窗口" Checked="RefreshWindowsClick" Unchecked="RefreshWindowsClick" Margin="0,5,18,5" /><Button Style="{StaticResource HelpIcon}" ToolTip="开始前自动恢复并激活所选游戏窗口；操作游戏开启时，工具按本机绑定发送按键或点击。" /></WrapPanel>
            <StackPanel x:Name="GameBindingSettings"><DockPanel><Button DockPanel.Dock="Right" Content="刷新窗口" Click="RefreshWindowsClick" /><ComboBox x:Name="GameWindowBox" DisplayMemberPath="Label" SelectionChanged="GameWindowChanged" ToolTip="标题、进程与最小化状态；仅操作此处选中的窗口" /></DockPanel>
            <WrapPanel x:Name="StartBindingControls"><TextBlock Text="触发 / 开始" Width="90" VerticalAlignment="Center" /><ComboBox x:Name="StartInputKind" Width="180" SelectedIndex="1" SelectionChanged="InputSettingsChanged"><ComboBoxItem Content="快捷键" /><ComboBoxItem Content="游戏按钮" /><ComboBoxItem x:Name="ChatDraftItem" Content="预填指令 · 仅按回车" /></ComboBox><Button x:Name="StartButtonHelp" Style="{StaticResource HelpIcon}" ToolTip="请选中乐谱的使用按钮位置。" /><TextBox x:Name="StartKeyBox" Width="165" IsReadOnly="True" IsReadOnlyCaretVisible="False" PreviewKeyDown="ShortcutKeyDown" GotKeyboardFocus="ShortcutFocused" LostKeyboardFocus="ShortcutBlurred" ToolTip="点击后直接按键；可用 Ctrl / Alt / Shift 组合。Tab 切换焦点，F9 保留。" /><Button x:Name="CaptureStartButton" Content="点选按钮位置" ToolTip="工具会暂时隐藏，点击游戏按钮来记录位置；右键、Esc 或 F9 取消。窗口尺寸或缩放改变后请重新记录。" Click="CaptureStartClick" /></WrapPanel>
            <TextBlock x:Name="StartCalibrationText" Foreground="#A8B4C7" TextWrapping="Wrap" />
            <StackPanel x:Name="StopBindingControls"><WrapPanel><TextBlock Text="停止演奏" Width="90" VerticalAlignment="Center" /><ComboBox x:Name="StopInputKind" Width="180" SelectedIndex="0" SelectionChanged="InputSettingsChanged"><ComboBoxItem Content="快捷键" /><ComboBoxItem Content="游戏按钮" /></ComboBox><TextBox x:Name="StopKeyBox" Width="165" IsReadOnly="True" IsReadOnlyCaretVisible="False" PreviewKeyDown="ShortcutKeyDown" GotKeyboardFocus="ShortcutFocused" LostKeyboardFocus="ShortcutBlurred" ToolTip="点击后直接按下专用停止快捷键" /><Button x:Name="CaptureStopButton" Content="点选按钮位置" ToolTip="工具会暂时隐藏，点击游戏按钮来记录位置；右键、Esc 或 F9 取消。窗口尺寸或缩放改变后请重新记录。" Click="CaptureStopClick" /></WrapPanel><TextBlock x:Name="StopCalibrationText" Foreground="#A8B4C7" TextWrapping="Wrap" /><CheckBox x:Name="StopIsToggleBox" Visibility="Collapsed" Content="开停切换绑定" Checked="InputSettingsChanged" Unchecked="InputSettingsChanged" /></StackPanel>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="ShortcutHint" Foreground="#A8B4C7" TextWrapping="Wrap" Margin="0,4,0,0" />
          <TextBlock x:Name="InputStateText" Foreground="#A8B4C7" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel></Expander></Border>
        <Border x:Name="RosterCard" Style="{StaticResource Card}"><Expander x:Name="RosterSection" IsExpanded="True"><Expander.Header><DockPanel><TextBlock x:Name="RosterTitle" Text="4  本轮参与者 · 房主勾选成员" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="RosterSummaryText" Text="" Margin="16,0,0,0" Foreground="#A8B4C7" /></DockPanel></Expander.Header><StackPanel>
          <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource HelpIcon}" ToolTip="房主可直接输入组号、顺序或选择身份与乐器，也可拖动昵称调整分组。每组一位乐谱使用者，指定新成员会把原成员改为参与者。右键昵称可设置总指挥或移出房间。修改后请重新就绪。" /><TextBlock x:Name="EnsembleRosterHint" Text="按列表顺序加入；实际进度显示在“加入状态”列。" TextWrapping="Wrap" Foreground="#A8B4C7" Margin="0,0,0,8" Visibility="Collapsed" /></DockPanel>
          <Grid x:Name="RosterViewport" SizeChanged="RosterViewportChanged"><ScrollViewer x:Name="RosterScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><DataGrid Width="{Binding ActualWidth,ElementName=RosterViewport}" MinWidth="920" x:Name="MembersGrid" AllowDrop="True" PreviewMouseLeftButtonDown="RosterPointerDown" PreviewMouseMove="RosterPointerMove" PreviewMouseRightButtonDown="RosterRightClick" DragOver="RosterDragOver" Drop="RosterDrop" ContextMenuOpening="RosterMenuOpening" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MinHeight="75" MaxHeight="180" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"><DataGrid.ContextMenu><ContextMenu /></DataGrid.ContextMenu><DataGrid.Columns>
            <DataGridTemplateColumn x:Name="GroupColumn" Header="组" Width="54" Visibility="Collapsed"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Background="{Binding GroupBackground}" ToolTip="合奏分组；同组使用相同底色" Text="{Binding Group, Mode=OneWay}" Tag="group" Style="{StaticResource RosterNumber}" IsReadOnly="{Binding ReadOnly}" LostKeyboardFocus="RosterNumberBlurred" PreviewKeyDown="RosterNumberKeyDown" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="OrderColumn" Header="顺序" Width="48" Visibility="Collapsed"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Order, Mode=OneWay}" Tag="order" Style="{StaticResource RosterNumber}" IsReadOnly="{Binding ReadOnly}" LostKeyboardFocus="RosterNumberBlurred" PreviewKeyDown="RosterNumberKeyDown" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="InstrumentColumn" Header="乐器" Width="146" Visibility="Collapsed"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource RosterChoice}" IsEnabled="{Binding CanEdit}" ItemsSource="{Binding InstrumentOptions, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" SelectedItem="{Binding Instrument, Mode=OneWay}" DropDownOpened="InstrumentDropdownOpened" SelectionChanged="RosterInstrumentChanged" ToolTip="编辑 Config/乐器列表.txt 可添加乐器" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="EnsembleRoleColumn" Header="合奏身份" Width="122" Visibility="Collapsed"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Style="{StaticResource RosterChoice}" IsEnabled="{Binding CanEdit}" ItemsSource="{Binding EnsembleRoles, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EnsembleRole, Mode=OneWay}" SelectionChanged="RosterRoleChanged" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridCheckBoxColumn Header="参与" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="46" /><DataGridTemplateColumn x:Name="NicknameColumn" Header="昵称" Width="*" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel VerticalAlignment="Center" Margin="4,0"><Border DockPanel.Dock="Right" Background="#223D60" CornerRadius="4" Padding="4,2" Margin="5,0,0,0" Visibility="{Binding IsSelf, Converter={StaticResource BooleanVisibility}}"><TextBlock Text="本机" Foreground="#9DC7FF" FontSize="12" FontWeight="SemiBold" /></Border><TextBlock VerticalAlignment="Center" Text="{Binding Nickname}" Foreground="{Binding NameBrush}" FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nickname}" /></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn x:Name="RoomRoleColumn" Header="角色" Binding="{Binding Role}" IsReadOnly="True" Width="65" ElementStyle="{StaticResource CenteredRosterText}" />
            <DataGridTemplateColumn Header="状态" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding StatusBackground}" CornerRadius="5" Margin="4,6" Padding="6,3" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="14" TextAlignment="Center" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="JoinFeedbackColumn" Header="加入状态" Width="1.3*" MinWidth="170" Visibility="Collapsed"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding JoinBackground}" CornerRadius="5" Margin="4,5" Padding="6,3" VerticalAlignment="Center"><TextBlock Text="{Binding JoinFeedback}" Foreground="{Binding JoinBrush}" FontSize="14" TextWrapping="Wrap" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns></DataGrid></ScrollViewer></Grid>
          <WrapPanel x:Name="LeaderControls" Margin="0,8,0,0"><TextBlock Text="指定总指挥" VerticalAlignment="Center" Margin="0,0,10,0" /><ComboBox x:Name="LeaderBox" Width="190" DisplayMemberPath="Nickname" SelectedValuePath="Id" SelectionChanged="LeaderChanged" /><Button Style="{StaticResource HelpIcon}" ToolTip="{Binding Text,ElementName=LeaderPurposeText}" /><TextBlock Visibility="Collapsed" x:Name="LeaderPurposeText" MaxWidth="520" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#A8B4C7" Margin="4,4,0,4" /></WrapPanel>
        </StackPanel></Expander></Border>
        <Expander Header="执行记录与诊断" Margin="0,0,0,8"><StackPanel Margin="0,8,0,0"><TextBlock x:Name="ClockText" Foreground="#A8B4C7" TextWrapping="Wrap" /><TextBox x:Name="ReceiptBox" IsReadOnly="True" Height="110" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" /><Button Content="导出诊断" Click="ExportClick" HorizontalAlignment="Left" /></StackPanel></Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
